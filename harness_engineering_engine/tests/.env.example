# Harness Engineering Engine — test environment example
#
# Copy to tests/.env and fill in local values before running tests that need
# real (non-mocked) configuration. Placeholder values only — never commit
# real credentials, bucket names, or tokens.

# --- Core engine ---
# Folder containing local skill directories (runtime cache).
HSK_SKILL_ROOT=./skills

# --- Git skill sources ---
# Skills are cloned directly from git — no artifact store in between.
# HTTPS remotes use whatever credential helper is already configured; SSH
# remotes use the system's default identity unless an alternate key is set.
# HSK_GIT_SSH_KEY_PATH=

# --- Local metadata / drift policy ---
# HSK_SKILL_LOCAL_METADATA_FILE=.hsk-skill.json
# HSK_SKILL_REFRESH_ON_STARTUP=false
# HSK_ALLOW_UNREGISTERED_CHANGES=false

# --- Guarded command executor ---
# Deny-by-default; enable explicitly when testing run_command.
# HSK_RUN_COMMAND_ENABLED=false
# HSK_RUN_COMMAND_DEFAULT_TIMEOUT_SECONDS=30
# HSK_RUN_COMMAND_OUTPUT_LIMIT_BYTES=20000
# HSK_RUN_COMMAND_WORKSPACE_ROOT=
# HSK_DRY_RUN=false

# --- P9: OpenAI-assisted generation of missing allowed_commands/ ---
# --- reference_files at deploy time (deploySkillPackage only) ---
# Empty key disables generation entirely (fails open — deploy still
# succeeds, the fields simply stay absent). OPENAI_API_KEY/OPENAI_BASE_URL
# are the same shared, non-HSK-prefixed settings other engines in this
# monorepo already use for their own OpenAI calls — setting them here
# affects those too. HSK_OPENAI_MODEL is harness-specific.
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# HSK_OPENAI_MODEL=gpt-4o-mini

# --- AWS (DynamoDB backend) ---
# REGION_NAME=us-east-1
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- PostgreSQL backend (optional, db_backend=postgresql) ---
# DB_BACKEND=postgresql
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=hsk
# DB_PASSWORD=
# DB_SCHEMA=harness_engineering_engine
# PG_TABLE_PREFIX=hsk_
